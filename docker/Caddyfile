# =============================================================================
# Caddy in front of toon-finance.
#
# WHY THERE IS A PROXY AT ALL: the PWA needs a SECURE CONTEXT. Browsers refuse
# to register a service worker over plain http (localhost excepted), and
# without the service worker there is no install prompt and no offline
# transaction entry — the one feature that is meant to work with the wifi off.
# So the app is always served over TLS, whatever it runs on.
#
# CERTIFICATES: TWO MODES, ONE VARIABLE.
#
#   TOON_TLS_ISSUER=acme      (default) a real, publicly trusted certificate.
#                             Needs a hostname that resolves to this machine
#                             from the internet and ports 80 + 443 reachable.
#                             Nothing to install on any device.
#   TOON_TLS_ISSUER=internal  Caddy's OWN local CA. No domain, no open ports,
#                             no ACME account — for a LAN box or a local test.
#
#   ⚠ In `internal` mode a device that does not trust that CA gets a warning
#     AND NO PWA: clicking through the interstitial does NOT make the origin
#     secure, the service worker still refuses to register. The root
#     certificate is served at http://<host>/toon-root-ca.crt for exactly that
#     reason and has to be installed once per device. In `acme` mode none of
#     that applies.
# =============================================================================
{
	# No admin API: it is a full control plane over the proxy, and nothing here
	# needs it. Off by default is one less thing listening in the container.
	admin off
}

# -----------------------------------------------------------------------------
# The app, over HTTPS.
# TOON_HOSTNAME comes from the compose .env. Use the SAME name on every device:
# a certificate is issued per name, so reaching the machine by IP is a fresh
# warning, and WEB_ORIGIN is built from it.
# -----------------------------------------------------------------------------
{$TOON_HOSTNAME} {
	tls {
		issuer {$TOON_TLS_ISSUER:acme}
	}

	encode zstd gzip

	reverse_proxy app:3001 {
		# ------------------------------------------------------------------
		# KEEP THIS, EVEN THOUGH CADDY LOGS IT AS "UNNECESSARY".
		#
		# The app runs with TRUST_PROXY=1 behind this proxy, so it believes
		# X-Forwarded-For and uses the FIRST entry as the client address for
		# every rate-limit bucket (login, registration, password reset). A
		# client that can choose that value has no rate limit at all — a
		# fresh header per request is a fresh bucket per request.
		#
		# Caddy's default is already correct (upstream sees the real peer),
		# but adding a `trusted_proxies` line later (a common copy-paste when
		# putting another proxy or Cloudflare in front) would silently
		# re-open the bypass, and this overwrite is what keeps that from
		# turning into an auth-bruteforcing hole. Cost: one startup warning.
		# Keep it.
		# ------------------------------------------------------------------
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	# The API is the only thing that may set the session cookie, and it does it
	# with HttpOnly/SameSite already. These are the headers a proxy can add
	# that the app cannot set for itself in a useful way.
	header {
		# NO Content-Security-Policy here on purpose. The app is same-origin end
		# to end, so a strict one would be cheap in principle — but vite
		# inlines a small bootstrap script, so a policy without the matching
		# hash silently turns the app into a blank page. Add one only together
		# with a build that emits the hashes, and test it on a phone before
		# deploying.
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# HSTS belongs with a publicly trusted certificate and is therefore on
		# by default. Set TOON_HSTS_MAX_AGE=0 for a LAN/internal-CA install:
		# pinning HTTPS for a name you may later reuse is a good way to lock
		# yourself out, and `max-age=0` is the documented way to release a pin
		# a browser has already stored.
		Strict-Transport-Security "max-age={$TOON_HSTS_MAX_AGE:31536000}"
		-Server
	}
}

# -----------------------------------------------------------------------------
# Plain HTTP: the ACME challenge (handled by Caddy itself, ahead of these
# routes), the local root certificate, and a redirect for everything else.
#
# The CA certificate is served over http ON PURPOSE — a device that does not
# trust the CA yet cannot fetch it over the HTTPS that this same CA signs
# without hitting the very warning we are trying to remove. What is published
# here is a PUBLIC certificate; the CA's private key never leaves the
# caddy-data volume. In `acme` mode there is no local CA and this route simply
# answers 404.
# -----------------------------------------------------------------------------
http://{$TOON_HOSTNAME} {
	handle /toon-root-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=toon-root-ca.crt"
		file_server
	}

	handle {
		redir https://{host}{uri} permanent
	}
}
