# ---------------------------------------------------------------------------
# toon-finance environment
# Copy to .env and fill in. The API validates all of this at boot (src/env.ts)
# and fails fast with a readable message.
# ---------------------------------------------------------------------------

# --- Database (libSQL, self-hosted file or Turso cloud) ---------------------
DATABASE_URL="file:./data/local.db"
# Turso cloud instead:
# DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# Only required for remote libsql:// URLs. Leave empty for file: DBs.
DATABASE_AUTH_TOKEN=""

# --- API server -------------------------------------------------------------
# Port the Hono/Bun.serve API listens on.
API_PORT="3001"
# The interface locale a request falls back to when Accept-Language is absent or
# unrecognised. "de" | "en".
DEFAULT_LOCALE="de"
# Exact origin of the web app, used for CORS in development (credentials: true).
# In the single-origin Docker deployment there is no cross-origin request at all.
WEB_ORIGIN="http://localhost:5173"
# 32+ char random secret. Generate: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-32-byte-random-hex-string-0000000"
# "development" | "production" | "test". Controls the Secure cookie flag + error verbosity.
NODE_ENV="development"
# Set to 1 ONLY when a reverse proxy (Caddy) sits in front of the API and
# OVERWRITES X-Forwarded-For. Otherwise the rate limiter uses the socket address,
# because a client-supplied header would let anyone reset their own login bucket
# by sending a new value on every request.
TRUST_PROXY=""

# --- Web app (Vite, must be inlined at build time) --------------------------
# Base URL of the API as seen from the browser. No trailing slash.
# LEAVE THIS EMPTY — in development AND in the container. The client then uses
# relative URLs like "/api/transactions", so one build works behind any hostname.
# In dev those relative URLs hit Vite's `server.proxy` (apps/web/vite.config.ts),
# which forwards /api to the API port; that proxy is what makes the browser see a
# SINGLE origin, which is why src/index.ts mounts no `cors()` (decision #7).
# Setting an absolute URL here bypasses the proxy and makes every browser request
# cross-origin — the API answers, but without CORS headers the browser blocks the
# response and the app renders "Keine Verbindung zum Server." while the network
# tab shows a perfectly good 200/401. Only set this when the API really is on
# another origin, and then add cors() to match.
PUBLIC_API_URL=""

# --- Serving the web app from the API --------------------------------------
# Directory of the built PWA. When set, the API serves it from its OWN port, which
# is how the container runs: one origin, no CORS, no second web server. Relative
# paths resolve from the repo root. Leave empty in development — vite serves it.
#   Docker:      /app/apps/web/dist   (already set in the image)
#   Locally:     ./apps/web/dist      (after `bun run build`, then open :3001)
WEB_DIST_DIR=""

# --- Mail (invites + password reset) -----------------------------------------
# ALL OPTIONAL. Leave MAIL_TRANSPORT empty (or "console") and the API logs every
# mail — invite link, password reset — and sends nothing. `bun run dev` and
# `bun test` then never touch the network:
#   * invite links are returned by the API and can be forwarded by hand,
#   * a locked-out account is unlocked with `bun run scripts/reset-password.ts <email>`.
#
# "console" (default) | "smtp"
MAIL_TRANSPORT=""
# Sender, "Name <adresse>" or a bare address. REQUIRED for MAIL_TRANSPORT=smtp.
MAIL_FROM=""

# --- Mail via SMTP (the only real transport, no third-party API key) --------
# This is what the Docker stack uses: MAIL_HOST="mailpit" on the private compose
# network, which accepts every message and shows it in a web UI. Point the same
# settings at a real relay and nothing else changes.
MAIL_HOST=""
# Defaults to 465 for MAIL_SECURITY="tls", otherwise 587. Mailpit listens on 1025.
MAIL_PORT=""
# Leave BOTH empty for a relay that does not authenticate (Mailpit).
MAIL_USER=""
MAIL_PASSWORD=""
# "starttls" (default) plaintext greeting then a MANDATORY TLS upgrade, port 587
# "tls"                TLS from the first byte, port 465
# "none"               plaintext for the whole session. Only defensible for a relay
#                      on the same private network — which is exactly Mailpit's
#                      case, and it needs no login. The API REFUSES TO START if you
#                      combine "none" with MAIL_USER, because those credentials
#                      would go over the wire in the clear.
MAIL_SECURITY=""
# Set to 1 to accept a self-signed certificate from your relay. Off unless needed.
MAIL_TLS_INSECURE=""

# --- Tests ------------------------------------------------------------------
# `bun test` always uses NODE_ENV=test, which forces DATABASE_URL to
# TEST_DATABASE_URL if set, otherwise "file::memory:". A ledger integration test
# that touches a transaction needs a real temp FILE (libSQL discards a
# file::memory: DB across the second connection client.transaction() opens), so
# most test files set TEST_DATABASE_URL themselves against a per-run temp file.
# Set this only if you want ALL tests to share one fixed file DB.
TEST_DATABASE_URL=""
